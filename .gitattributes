# Consistent LF line endings across the repo so `node build.mjs` output is
# reproducible and sprint diffs stay content-only (no CRLF/LF churn).
* text=auto eol=lf

# The built single-file app embeds a couple of NUL bytes that trip git's
# binary heuristic. Force text + LF so its diffs stay line-based and the
# build artifact commits cleanly on every platform.
gamma-node-editor.html text eol=lf
